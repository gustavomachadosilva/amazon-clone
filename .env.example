# Database
DB_NAME=mercatto
DB_USER=mercatto
DB_PASSWORD=mercatto
DB_PORT=5432

# Backend
BACKEND_PORT=8080

# Directory where review photos/videos are stored on disk (relative to the backend's working
# directory when running locally). docker-compose overrides it to the review_media volume.
MEDIA_DIR=./data/review-media

# dev = roda os seeds automáticos de usuários/produtos ao subir (nunca em produção).
# Deixe vazio ou defina outro valor (ex. prod) para desativar o seed.
SPRING_PROFILES_ACTIVE=dev

# Frontend
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8080

# Future integrations — not wired into any bean yet, kept here so the
# ports already in the code (PaymentGateway, etc.) have somewhere to read
# real credentials from once they're implemented.
JWT_SECRET=replace-me

# Leave as "replace-me" (or empty) to use MockPaymentGateway (approves by
# default, no network calls — see PAYMENT_MOCK_DECLINE below). Set to a real
# Stripe TEST secret key (sk_test_...) to activate StripePaymentGateway in
# Stripe test mode. Never put a live key (sk_live_...) here.
STRIPE_API_KEY=replace-me

# Makes MockPaymentGateway decline deterministically, to reproduce a FAILED
# order and its payment retry (POST /api/orders/{id}/payment) locally:
#   none          approve every charge (default)
#   always        decline every charge
#   first-attempt decline the first charge of each order, approve the retries
# Ignored when a real STRIPE_API_KEY is set.
# PAYMENT_MOCK_DECLINE=first-attempt
