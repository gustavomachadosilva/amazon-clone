# Database
DB_NAME=mercatto
DB_USER=mercatto
DB_PASSWORD=mercatto
DB_PORT=5432

# Backend
BACKEND_PORT=8080

# dev = roda os seeds automáticos de usuários/produtos ao subir (nunca em produção).
# Deixe vazio ou defina outro valor (ex. prod) para desativar o seed.
SPRING_PROFILES_ACTIVE=dev

# Frontend
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8080

# Future integrations — not wired into any bean yet, kept here so the
# ports already in the code (PaymentGateway, etc.) have somewhere to read
# real credentials from once they're implemented.
JWT_SECRET=replace-me

# Leave as "replace-me" (or empty) to use MockPaymentGateway (always approves,
# no network calls). Set to a real Stripe TEST secret key (sk_test_...) to
# activate StripePaymentGateway in Stripe test mode. Never put a live key
# (sk_live_...) here.
STRIPE_API_KEY=replace-me
